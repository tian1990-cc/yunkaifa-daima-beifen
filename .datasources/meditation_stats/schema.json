{
  "name": "meditation_stats",
  "title": "冥想统计",
  "schemas": [
    {
      "name": "userId",
      "title": "用户ID",
      "type": "String"
    },
    {
      "name": "totalMinutes",
      "title": "总冥想分钟数",
      "type": "Number"
    },
    {
      "name": "streakDays",
      "title": "连续天数",
      "type": "Number"
    },
    {
      "name": "sessionsCount",
      "title": "完成次数",
      "type": "Number"
    },
    {
      "name": "lastSessionDate",
      "title": "最后一次冥想日期",
      "type": "Date",
      "format": "timestamp-ms"
    },
    {
      "name": "backgroundSound",
      "title": "背景音",
      "type": "String"
    },
    {
      "name": "duration",
      "title": "单次时长",
      "type": "Number"
    }
  ]
}