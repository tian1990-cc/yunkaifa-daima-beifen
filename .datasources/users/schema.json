{
  "name": "users",
  "title": "用户信息",
  "schemas": [
    {
      "name": "username",
      "title": "用户名",
      "type": "String"
    },
    {
      "name": "email",
      "title": "邮箱",
      "type": "String"
    },
    {
      "name": "password",
      "title": "密码",
      "type": "String"
    },
    {
      "name": "avatarUrl",
      "title": "头像URL",
      "type": "Url"
    },
    {
      "name": "totalMeditationMinutes",
      "title": "总冥想分钟数",
      "type": "Number"
    },
    {
      "name": "streakDays",
      "title": "连续天数",
      "type": "Number"
    },
    {
      "name": "sessionsCount",
      "title": "完成次数",
      "type": "Number"
    },
    {
      "name": "lastSessionDate",
      "title": "最后一次冥想日期",
      "type": "DateTime",
      "format": "timestamp-ms"
    }
  ]
}